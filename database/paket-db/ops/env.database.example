# Potongan .env Laravel (lokal Laragon). Nilai asli JANGAN di-commit.
APP_ENV=local
APP_DEBUG=true            # staging/produksi WAJIB false (TMN-09)
APP_TIMEZONE=UTC
APP_KEY=base64:****************************************
NIK_HMAC_KEY=base64:****************************************   # php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"

BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=polibatam_verify
DB_USERNAME=pv_app
DB_PASSWORD="********"

DB_MIGRATOR_USERNAME=pv_migrator
DB_MIGRATOR_PASSWORD="********"

DB_REPORT_USERNAME=pv_report
DB_REPORT_PASSWORD="********"

SANCTUM_EXPIRATION=720    # 12 jam (K-30, TMN-14)
