APP_NAME="Polibatam Verify"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://polibatam-verify.test
APP_TIMEZONE=UTC

# Kunci HMAC nik_hash, TERPISAH dari APP_KEY (K-36). Bangkitkan: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
NIK_HMAC_KEY=

# Rute /_preview (PRD §4.1), hanya berlaku bila APP_ENV=local
PV_PREVIEW=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Tiga akun MySQL terpisah (AE-13, Keamanan DB §3). Password WAJIB bertanda kutip (AE-16).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=polibatam_verify
DB_USERNAME=pv_app
DB_PASSWORD=""

DB_REPORT_USERNAME=pv_report
DB_REPORT_PASSWORD=""

DB_MIGRATOR_USERNAME=pv_migrator
DB_MIGRATOR_PASSWORD=""

# Tes otomatis Pest (07_akun_tes_lokal.sql), KHUSUS LOKAL
DB_TEST_DATABASE=polibatam_verify_test
DB_TEST_USERNAME=pv_test
DB_TEST_PASSWORD=""

# Disk arsip periode (write-once, ikut backup). Lokal: storage/app/arsip
FILESYSTEM_ARSIP_DRIVER=local
FILESYSTEM_ARSIP_ROOT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lokal: Mailpit (UI http://localhost:8025). Staging: Brevo. Produksi: SMTP Polibatam (NFR-44, NFR-46)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@polibatam-verify.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
