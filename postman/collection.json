                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"challenge_token\":\"architecto\",\"code\":\"123456\",\"recovery_code\":\"architecto\"}"
                        },
                        "description": "Mengembalikan token Sanctum yang berlaku 12 jam. Gagal berturut-turut mengunci akun seperti di web (BR-03).",
