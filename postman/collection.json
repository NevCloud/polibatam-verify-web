                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"email\":\"silau@polibatam-verify.test\",\"password\":\"|]|{+-\",\"nama_perangkat\":\"Pixel 8 Bayu\"}"
                        },
                        "description": "Selalu mengembalikan `challenge_token` (2FA wajib untuk admin, K-33). Hanya Admin SILAU & Admin Keuangan; role lain 403.",
                        "auth": {
                            "type": "noauth"
                        }
