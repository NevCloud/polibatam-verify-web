    "item": [
        {
            "name": "Autentikasi",
            "description": "\nLogin dua tahap (FR-60, BR-59, NFR-47): password \u2192 `challenge_token` \u2192 kode TOTP \u2192 token Bearer 12 jam per perangkat.",
            "item": [
                {
                    "name": "Login (tahap 1)",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/v1\/auth\/login",
                            "query": [],
