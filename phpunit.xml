<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true": selalu menimpa variabel yang sudah ada di terminal/IDE (mis. DB_CONNECTION dari .env), agar tes tidak pernah memakai DB aplikasi -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:S90EThu6r3R6+LW2Mr1AiXAM3mfa753KRzVTSa3MlqY=" force="true"/>  <!-- kunci khusus tes, bukan rahasia -->
        <env name="NIK_HMAC_KEY" value="base64:a8yxkco0h/kWZqxW17Qy8IovSTY4s8Pj6m2BRGjkf+k=" force="true"/>  <!-- kunci khusus tes -->
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="mysql_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <!-- $_SERVER juga ditimpa: Laravel membaca $_SERVER lebih dulu daripada $_ENV -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="mysql_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="APP_KEY" value="base64:S90EThu6r3R6+LW2Mr1AiXAM3mfa753KRzVTSa3MlqY=" force="true"/>
        <server name="NIK_HMAC_KEY" value="base64:a8yxkco0h/kWZqxW17Qy8IovSTY4s8Pj6m2BRGjkf+k=" force="true"/>
    </php>
</phpunit>
